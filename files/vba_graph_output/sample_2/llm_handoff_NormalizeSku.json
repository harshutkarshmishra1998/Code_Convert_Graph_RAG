se vbObjectError + 1001, \"NormalizeSku\", \"SKU is required.\"\n    End If\n\n    If VarType(rawSku) <> vbString Then\n        Err.Raise vbObjectError + 1002, \"NormalizeSku\", \"SKU must be text.\"\n    End If\n\n    normalized = UCase$(Trim$(CStr(rawSku)))\n    If Len(normalized) < 4 Or Len(normalized) > 24 Then\n        Err.Raise vbObjectError + 1003, \"NormalizeSku\", \"SKU length is invalid.\"\n    End If\n\n    Select Case True\n        Case normalized Like \"*[!A-Z0-9-]*\"\n            Err.Raise vbObjectError + 1004, \"NormalizeSku\", \"SKU contains unsupported characters.\"\n        Case Else\n            NormalizeSku = normalized\n    End Select\n\n    Exit Function\n\nInvalidSku:\n    Err.Raise Err.Number, \"NormalizeSku\", Err.Description\nEnd Function","source_location":{"line":3,"end_line":32,"file":"vba_sample_2.bas"},"segment_id":"segment_1e1ab4f77ef353c7"},"direct_callees":[],"semantic_procedure_report":{"procedure":"NormalizeSku","unresolved_expression_count":0,"parsed_expression_count":57,"invocation_count":22,"pseudocode_coverage":"missing_detailed_section","control_flow_integrity":"no_frontend_block_diagnostic_reported"},"pseudocode_section":null,"fixer_issue_statuses":[{"issue_id":"fc822ff4891c4a5d","issue":{"code":"PSEUDOCODE_COVERAGE_GAP","severity":"warning","message":"Detailed pseudocode section missing: NormalizeSku","procedure":"NormalizeSku"},"detected":true,"addressed":false,"status":"detected_unresolved","changes":[],"resolution_evidence":null,"verification":{"present_in_final_issue_set":true,"absent_after_final_scan":false,"downstream_resolution":null}}]}
