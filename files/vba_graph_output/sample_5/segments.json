  {
    "id": "segment_f89ff8747e926266",
    "parent_id": "procedure_f89ff8747e926266",
    "kind": "PROCEDURE",
    "name": "LogInventoryError",
    "path": "vba_sample_5.bas",
    "start_line": 106,
    "end_line": 119,
    "source": "Public Sub LogInventoryError(ByVal errorNumber As Long, ByVal description As String, ByVal itemCode As String)\n    Dim logSheet As Worksheet\n    Dim nextLogRow As Long\n\n    On Error Resume Next\n    Set logSheet = ThisWorkbook.Worksheets(\"Error Log\")\n    If logSheet Is Nothing Then Exit Sub\n\n    nextLogRow = logSheet.Cells(logSheet.Rows.Count, \"A\").End(xlUp).Row + 1\n    logSheet.Cells(nextLogRow, \"A\").Value = Now\n    logSheet.Cells(nextLogRow, \"B\").Value = errorNumber\n    logSheet.Cells(nextLogRow, \"C\").Value = description\n    logSheet.Cells(nextLogRow, \"D\").Value = itemCode\nEnd Sub",
    "summary": null,
    "annotations": {}
  },
